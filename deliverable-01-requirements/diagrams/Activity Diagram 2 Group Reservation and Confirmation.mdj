										"$ref": "25c672f625e14c1aada5b616e0a4cb7a"
									},
									"containerView": {
										"$ref": "a5b1f37701c74d39b5027de0eb5f4f22"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;16;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 638,
									"top": 2010,
									"width": 26,
									"height": 26
								},
								{
									"_type": "UMLNoteView",
									"_id": "6cb51cc8ff1d4ede8748b46a21669163",
									"_parent": {
										"$ref": "fe6c05ef44564eb187c1ed4abf8ee28c"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 45,
									"top": 320,
									"width": 265,
									"height": 120,
									"text": "Group organiser:\nTour operator, or Ministry of Education representative booking for a school."
								},
								{
									"_type": "UMLNoteView",
									"_id": "caf16e468cd34c16a7dbd7170deff828",
									"_parent": {
										"$ref": "fe6c05ef44564eb187c1ed4abf8ee28c"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 45,
									"top": 472,
									"width": 265,
									"height": 285,
									"text": "Eligible request:\nComplete details, positive whole number size, and a released future 30 minute slot.\n\nTour operator: submit before the 48 hour deadline.\nSchool: book through the Ministry of Education for a weekday morning."
								},
								{
									"_type": "UMLNoteView",
									"_id": "963b476e0a914da8b55f889caa44fcc2",
									"_parent": {
										"$ref": "fe6c05ef44564eb187c1ed4abf8ee28c"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 45,
									"top": 810,
									"width": 265,
									"height": 165,
									"text": "A-14: School bookings are confirmed immediately when eligible and capacity is available. No provisional 48 hour hold is assumed for schools."
								},
								{
									"_type": "UMLNoteView",
									"_id": "0d35d94de7fb42518790d169c935d401",
									"_parent": {
										"$ref": "fe6c05ef44564eb187c1ed4abf8ee28c"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 45,
									"top": 1100,
									"width": 265,
									"height": 225,
									"text": "A-01: Confirm final size before the deadline: 48 hours before the entry slot start.\n\nThe size may be smaller or larger than the block. An increase needs extra places.\n\nA failed change keeps the current block and original deadline."
								},
								{
									"_type": "UMLNoteView",
									"_id": "4d4e18f7432544f69684ce29cb970363",
									"_parent": {
										"$ref": "fe6c05ef44564eb187c1ed4abf8ee28c"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 45,
									"top": 1430,
									"width": 265,
									"height": 245,
									"text": "Can confirm in time?\nPositive whole-number size; enough held + extra places; still before deadline.\n\nRecheck capacity when saving. Never overbook. If the deadline has passed, the next wait ends immediately."
								},
								{
									"_type": "UMLNoteView",
									"_id": "71dd199e6a624cf188051ae21b97e82f",
									"_parent": {
										"$ref": "fe6c05ef44564eb187c1ed4abf8ee28c"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 45,
									"top": 1780,
									"width": 265,
									"height": 180,
									"text": "Confirms group size and places.\n\nPayment and gate admission\nare separate processes.\n\nSlot capacity is separate from\nsafe hall capacity."
								},
