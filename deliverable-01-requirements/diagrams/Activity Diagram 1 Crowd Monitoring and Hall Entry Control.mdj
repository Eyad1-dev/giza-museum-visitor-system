							"name": "Hall sensors",
							"nodes": [
								{
									"_type": "UMLAction",
									"_id": "4cd62b7f29424900a07feacb578578e1",
									"_parent": {
										"$ref": "7bba8b08fcda419ea812a6d1616ea28e"
									},
									"name": "Send count and humidity data",
									"documentation": "Count every minute for each hall; humidity readings apply to sensitive halls (A-08)."
								}
							]
						},
						{
							"_type": "UMLActivityPartition",
							"_id": "4d146bbae5d84a61900cba586ff36e6c",
							"_parent": {
								"$ref": "f69a388937e64c4ba1a7b5c6863565c8"
							},
							"name": "Museum system",
							"nodes": [
								{
									"_type": "UMLInitialNode",
									"_id": "c97388800e254b5a801873a6f3e2e5bb",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "New hall update"
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "c3093444c1f64ce28a9d30c042dac93f",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Update source?"
								},
								{
									"_type": "UMLAction",
									"_id": "b42daf70912d4492916e2ea8afcc9751",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Store minute count\nand latest readings"
								},
								{
									"_type": "UMLMergeNode",
									"_id": "425f0a5ab4124eebb6edb7f65848bb23",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Merge update sources"
								},
								{
									"_type": "UMLAction",
									"_id": "03e3144408f0430d83f976d9f0c13e80",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Read safe capacity\nand hall restrictions"
								},
								{
									"_type": "UMLAction",
									"_id": "80d4d00a4106427ab7dd8725c62af60e",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Update humidity hold",
									"documentation": "A-08/A-09: set hold when humidity exceeds the sensitive hall limit. Retain until readings are normal AND authorised Conservation clearance is present. Do not clear a hold merely because occupancy falls."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "7e2dc09d410c4350bed180bf2c52972b",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Closed or full?"
								},
								{
									"_type": "UMLAction",
									"_id": "894f81ef75814a30950f6f59c70580d5",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Stop new entry",
									"documentation": "Stop if closure active or count >= capacity. Record the applicable reason. Do not block exits."
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "1cb756012045473382fa08fc23b0b9e6",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Humidity hold active?"
								},
								{
									"_type": "UMLAction",
									"_id": "9c96995399bf4eca9739044f316109b5",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Limit entry to 50%\nof normal rate",
									"documentation": "A-08: floor(0.5 * normal admissions/minute). Do not change capacity. Remaining safe space always limits actual admissions further."
								},
								{
									"_type": "UMLAction",
									"_id": "2d64cc770b9e48d7828f1c48a898dbf7",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Allow / resume entry",
									"documentation": "Reached only if hall open, count below capacity, and no active humidity hold. Record the admission state."
								},
								{
									"_type": "UMLMergeNode",
									"_id": "c1b4402e7d6148d7b1dc3b273eb20a98",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Merge admission-rate paths"
								},
								{
									"_type": "UMLMergeNode",
									"_id": "3c78b010ca4e4563853bc30b89de21a6",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Merge entry outcomes"
								},
								{
									"_type": "UMLDecisionNode",
									"_id": "230bca8566224f248b477543e03789a6",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "At least 85% of capacity?"
								},
								{
									"_type": "UMLAction",
									"_id": "9d5b5f20dc06425c884a0dbdee9d2dd6",
									"_parent": {
										"$ref": "4d146bbae5d84a61900cba586ff36e6c"
									},
									"name": "Clear crowd warning",
									"documentation": "Clear only the crowd warning. Manual closure and humidity restrictions remain unchanged."
								},
								{
