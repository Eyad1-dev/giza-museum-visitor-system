{
	"_type": "Project",
	"_id": "b8004b96622c45dfb0c84956ff3fe166",
	"name": "Giza Museum Visitor System",
	"ownedElements": [
		{
			"_type": "UMLModel",
			"_id": "c8133a3b7613485e9aaec8a750ed334c",
			"_parent": {
				"$ref": "b8004b96622c45dfb0c84956ff3fe166"
			},
			"name": "Museum use cases",
			"ownedElements": [
				{
					"_type": "UMLUseCaseSubject",
					"_id": "d69eddcffbc14f4683970a0ea3f468ca",
					"_parent": {
						"$ref": "c8133a3b7613485e9aaec8a750ed334c"
					},
					"name": "Giza Museum Visitor System",
					"ownedElements": [
						{
							"_type": "UMLUseCase",
							"_id": "f5e88b50353e43e5b8178cf05b905a24",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC01 View Available Entry Slots",
							"documentation": "Actors: Visitor. Trigger: E01.\nThe visitor picks a date to see which entry slots still have places. Ticket categories, prices and any required eligibility documents appear with the availability information."
						},
						{
							"_type": "UMLUseCase",
							"_id": "c7531995940c45c68dd396f6ee483e7c",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC02 Purchase Entry Tickets",
							"documentation": "Actors: Visitor or Gate Staff; supporting Payment Provider. Trigger: E02.\nAfter the visitor or gate staff choose the tickets, the system checks the available places and processes payment. A successful purchase produces the tickets and a record of the price paid."
						},
						{
							"_type": "UMLUseCase",
							"_id": "3d41f332b52544a0976da8c5f55a17f6",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC03 Schedule Ticket Prices",
							"documentation": "Actors: Ticketing Manager. Trigger: E03.\nThe Ticketing Manager enters each price with the date it takes effect. That price applies to new purchases from its effective date; tickets already paid for retain their recorded price."
						},
						{
							"_type": "UMLUseCase",
							"_id": "82a9da9df61a45edb3daba9f78a8d020",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC04 Inspect Applied Ticket Price",
							"documentation": "Actors: Ticketing Staff. Trigger: E04.\nStaff open a completed sale to check its purchase date, ticket category and amount paid. They can compare this with the price that was effective when the purchase was made."
						},
						{
							"_type": "UMLUseCase",
							"_id": "6b949218e8e14e15806ba59366fd0aa6",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC05 Configure Entry Slot Capacity",
							"documentation": "Actors: Ticketing Manager. Trigger: E05.\nThe Ticketing Manager configures each 30-minute entry window and its capacity after the Director approves the plan outside the system. The capacity limits the number of tickets available for that slot."
						},
						{
							"_type": "UMLUseCase",
							"_id": "2c92283e226f49b99ef456b9e824fcd7",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC06 Release Entry Slots",
							"documentation": "Actors: No human initiator. Trigger: E06.\nAt 09:00 Cairo time each day, entry slots become available for the date 30 days ahead. The release uses the approved slot capacities."
						},
						{
							"_type": "UMLUseCase",
							"_id": "91d99c73f56e460a872bbf1b3543df67",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC07 Reserve Group Block",
							"documentation": "Actors: Tour Operator. Trigger: E07.\nA tour operator requests a block of places. If the request is eligible and space is available, the system holds the places and supplies a reference. Confirmation is due 48 hours before entry. A-01 permits size changes before the deadline, subject to remaining capacity."
						},
						{
							"_type": "UMLUseCase",
							"_id": "985c2688473f4d6b934eb494b4adbb89",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC08 Amend Group Reservation",
							"documentation": "Actors: Tour Operator. Trigger: E08.\nBefore the confirmation deadline, the operator may reduce a provisional block or request extra places. Increases depend on availability. A failed change leaves the existing block and its original deadline in place."
						},
						{
							"_type": "UMLUseCase",
							"_id": "33abced521a04645b8ddcac487430aec",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC09 Confirm Group Reservation",
							"documentation": "Actors: Tour Operator. Trigger: E09.\nThe operator submits the final group size by the 48-hour deadline. After checking the size and available capacity, the system confirms the booking, releases unused reserved places and sends confirmation."
						},
						{
							"_type": "UMLUseCase",
							"_id": "18a611621abd4b998fb540e23dbebabd",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC10 Release Unconfirmed Group Places",
							"documentation": "Actors: No human initiator; Tour Operator receives notification. Trigger: E10.\nAt 48 hours before entry, any remaining unconfirmed tour-operator reservation expires. Its places return to availability, and the operator receives an expiry notification."
						},
						{
							"_type": "UMLUseCase",
							"_id": "8dcc02a9270044de941316e51d489a5e",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC11 Book School Visit",
							"documentation": "Actors: Ministry Booking Staff. Trigger: E11.\nMinistry booking staff submit the final school group size for a weekday morning slot. An eligible request with enough places is confirmed immediately at zero price, as specified in A-14."
						},
						{
							"_type": "UMLUseCase",
							"_id": "f2c3bf0f3250481f880385d559d53cac",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC12 Refund Individual Ticket",
							"documentation": "Actors: Visitor, assisting Ticketing Staff and Payment Provider. Trigger: E12.\nAn unused individual ticket can be refunded when the request meets the 24-hour deadline or the museum-cancellation exception. The payment provider processes the refund, and the booking and available places are updated. The voluntary refund carries no administration fee (A-02)."
						},
						{
							"_type": "UMLUseCase",
							"_id": "043d7e5d1c294b5f9e6ab2a112c08b77",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC13 Exchange Individual Ticket",
							"documentation": "Actors: Visitor, assisting Ticketing Staff and Payment Provider. Trigger: E13.\nThe visitor chooses a replacement slot. The request must meet the individual-ticket policy, and the new slot must have space. Any price difference is settled before the ticket and slot allocations are updated. For voluntary exchanges, the ticket must be unused and the request must arrive at least 24 hours before entry. A museum cancellation permits available rebooking regardless of the deadline."
						},
						{
							"_type": "UMLUseCase",
							"_id": "77013b705dbf4f4c87b884c1f9f01e25",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC14 Validate Museum Entry",
							"documentation": "Actors: Visitor, Gate Staff and supporting entry-device interface. Trigger: E14.\nGate staff check ID for citizen and student tickets. The system checks the ticket’s entry slot and status. For an unreadable QR code, authorised staff retrieve the booking and perform the same checks. Entry stays on hold if staff cannot verify eligibility."
						},
						{
							"_type": "UMLUseCase",
							"_id": "01f613458298481292eb74a8e73ac03f",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC15 Record Anonymous Hall Measurements",
							"documentation": "Actors: Hall Sensing Service. Trigger: E15.\nAnonymous visitor counts arrive each minute for the 40 halls, along with humidity readings for sensitive halls. The system stores these measurements, updates the security view and checks for changes that require a warning or restriction."
						},
						{
							"_type": "UMLUseCase",
							"_id": "c88cd2294f3e499197f05ae3ab351f51",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC16 View Live Hall Conditions",
							"documentation": "Actors: Authorised Security Staff. Trigger: E16.\nSecurity staff open the live hall view to see visitor counts, safe capacities and active warnings. Humidity readings and any admission restrictions are shown for the relevant halls."
						},
						{
							"_type": "UMLUseCase",
							"_id": "e803d59fc99d49c68df5316e3ce756b3",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC17 Issue Crowd Warning",
							"documentation": "Actors: No human initiator; Security Staff and Visitors receive information. Trigger: E17.\nCrossing from below 85% to at least 85% of safe capacity triggers a crowd warning. Security receives an alert, and visitors receive suggestions for quieter routes."
						},
						{
							"_type": "UMLUseCase",
							"_id": "f3a6dec9c0384d94bb924124d61daa3a",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC18 Clear Crowd Warning",
							"documentation": "Actors: No human initiator; Security Staff and Visitors receive updates. Trigger: E18.\nOnce occupancy falls below 85%, the crowd warning is removed and visitor guidance is updated. Clearing this warning leaves other hall restrictions in place."
						},
						{
							"_type": "UMLUseCase",
							"_id": "1f720f8c16d043c8b267a07738c92499",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC19 Stop Hall Admission",
							"documentation": "Actors: No human initiator; supporting admission interface and Security Staff. Trigger: E19.\nNew admissions stop when a hall reaches or exceeds its safe capacity. Routes and security information are updated to reflect the stop. Visitors already inside can still leave."
						},
						{
							"_type": "UMLUseCase",
							"_id": "1030e1c48d4942a29a81fd58af81a0fa",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC20 Reassess Hall Admission Below Capacity",
							"documentation": "Actors: No human initiator; supporting admission interface and Security Staff. Trigger: E20.\nWhen a full hall falls below safe capacity, the capacity stop can be removed. The system checks for manual closures and humidity restrictions before deciding whether, and at what rate, entry may resume."
						},
						{
							"_type": "UMLUseCase",
							"_id": "cadac254b591495cb7bf4745a622f25d",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC21 Apply Humidity Admission Restriction",
							"documentation": "Actors: No human initiator; supporting admission interface and Conservation Staff. Trigger: E21.\nA humidity reading above the configured limit activates a hold in the sensitive hall. Admissions are limited to half the normal per-minute allowance, rounded down. Safe capacity remains unchanged, and stricter restrictions still apply."
						},
						{
							"_type": "UMLUseCase",
							"_id": "6edfb19d73174856b5c6fe6eb2965fec",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC22 Clear Humidity Admission Restriction",
							"documentation": "Actors: Authorised Conservation Staff. Trigger: E22.\nAfter humidity returns within safe limits, authorised conservation staff request clearance. The system checks the readings before removing the hold. A manual closure or capacity stop remains in force if it still applies."
						},
						{
							"_type": "UMLUseCase",
							"_id": "7802387e630d417783eebeb90dff8eb0",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC23 Close Hall",
							"documentation": "Actors: Security Supervisor. Trigger: E23.\nThe Security Supervisor closes a hall for maintenance or a VIP visit. The closure stops new admissions and is reflected in visitor routes, guide availability and the security view."
						},
						{
							"_type": "UMLUseCase",
							"_id": "b8ef7c75532e422fafeaed45d705ef9e",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC24 Reopen Hall",
							"documentation": "Actors: Security Supervisor. Trigger: E24.\nThe Security Supervisor requests removal of a manual closure. Current occupancy and any humidity hold are checked before entry resumes."
						},
						{
							"_type": "UMLUseCase",
							"_id": "d3743edda4fb4032b78d994e1ac22589",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC25 Change Hall Safe Capacity",
							"documentation": "Actors: Chief Curator. Trigger: E25.\nOnly the Chief Curator can change a hall’s safe capacity. After saving the new value, the system reassesses warnings and admission restrictions against it (K-01)."
						},
						{
							"_type": "UMLUseCase",
							"_id": "a9b70583c3004eb6beabdd9e43b1d8f7",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC26 Maintain Safe AR Viewing Areas",
							"documentation": "Actors: Chief Curator and Security Supervisor. Trigger: E26.\nThe Chief Curator and Security Supervisor jointly designate safe camera-AR areas. The system records those areas so the guide can limit camera AR to them (K-02). Text, audio and navigation remain available elsewhere."
						},
						{
							"_type": "UMLUseCase",
							"_id": "47fa3dcb327f4857b5726a4ea2accf72",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC27 Prepare Guide Content",
							"documentation": "Actors: Curator. Trigger: E27.\nA curator writes or revises artifact and tour material. Drafts are saved, and public artifact text is sent to the Chief Curator for review before publication."
						},
						{
							"_type": "UMLUseCase",
							"_id": "ac9334a8ff61451a80200758c53dff4c",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC28 Review and Publish Guide Content",
							"documentation": "Actors: Chief Curator. Trigger: E28.\nThe Chief Curator reviews the submitted version. Approval and publication make that version available to visitors immediately. A version returned for revision stays unpublished and goes back to the curator with feedback."
						},
						{
							"_type": "UMLUseCase",
							"_id": "8a3d7f2e9804454bb154c55050ee9d75",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC29 Download Offline Guide",
							"documentation": "Actors: Visitor. Trigger: E29.\nVisitors can download approved text and audio in their chosen supported language for use offline. The download excludes public 3D model files and is optional for museum admission."
						},
						{
							"_type": "UMLUseCase",
							"_id": "a041ac4828484ce08c670fb8d83830d4",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC30 Explore Artifact Guide",
							"documentation": "Actors: Visitor. Trigger: E30.\nSelecting or scanning an artifact opens its approved story and permitted online 3D experience. Camera AR follows the designated-area restrictions. Recorded scans contribute to the usage reports."
						},
						{
							"_type": "UMLUseCase",
							"_id": "67760360e54a4306bc7a8f0b5b98dfd2",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC31 Follow Themed or Accessible Tour",
							"documentation": "Actors: Visitor. Trigger: E31.\nThe visitor requests a themed or accessible route. Hall closures, crowd levels and elevator availability affect the route offered. If no accessible route is available, the visitor is told this and directed to staff."
						},
						{
							"_type": "UMLUseCase",
							"_id": "5b794791598f47b98bba88c9417bc709",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC32 Use Accessible Multilingual Guide",
							"documentation": "Actors: Visitor. Trigger: E32.\nThe guide offers approved content in 12 supported languages. Visitors can also request audio descriptions or larger text to suit their needs."
						},
						{
							"_type": "UMLUseCase",
							"_id": "7ecc8118440f4b878518dd54cdaa3fb3",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC33 View Elevator and Visitor Conditions",
							"documentation": "Actors: Visitor. Trigger: E33.\nVisitors can check elevator availability and crowd conditions, along with the last update time. Information that is outdated or unavailable is marked accordingly."
						},
						{
							"_type": "UMLUseCase",
							"_id": "669347f553b84b47bde21da03c3ef557",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC34 Update Elevator Service Status",
							"documentation": "Actors: Security Supervisor. Trigger: E34.\nThe Security Supervisor enters a verified elevator status change. A timestamp is saved with it, and affected routes and visitor information are updated under assumption D2-A03."
						},
						{
							"_type": "UMLUseCase",
							"_id": "39cd9135d5eb4b5ba38112eb13545229",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC35 Submit Research Access Request",
							"documentation": "Actors: Researcher. Trigger: E35.\nThe researcher enters the details and proposed date of a storage-room visit. The request is recorded and passed to the Conservation Department for a decision."
						},
						{
							"_type": "UMLUseCase",
							"_id": "f5ba50248ecb4cc4bccc9c16714c667a",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC36 Decide Research Access and Assign Conservator",
							"documentation": "Actors: Conservation Department; Conservator where assignment requires participation. Trigger: E36.\nThe Conservation Department records its decision and assigns an available conservator to an approved visit. Approval must be completed at least seven days before the visit, and the visit date and assigned supervisor are recorded."
						},
						{
							"_type": "UMLUseCase",
							"_id": "adc953b5124d4cd0b73418e1fc9691c0",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC37 Verify Supervised Research Visit",
							"documentation": "Actors: Conservation Staff or supervising Conservator. Trigger: E37.\nConservation staff or the supervising conservator verify that approval was completed at least seven days before the visit and that the assigned conservator is present. The system records the outcome and allows the visit to proceed only when both conditions hold (K-03)."
						},
						{
							"_type": "UMLUseCase",
							"_id": "b5afb36f0b784ee987d12b23c948cfea",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC38 Record Anonymous Hall Visit Duration",
							"documentation": "Actors: Anonymous Hall Visit Service. Trigger: E38.\nUnder D2-A01, valid entry and exit timestamps are paired for an anonymous hall visit. The record has no link to a face, name or ticket and provides the duration used in average-stay reports."
						},
						{
							"_type": "UMLUseCase",
							"_id": "74becc587462474e87ab1e318a39163c",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC39 View Hall Crowding Report",
							"documentation": "Actors: Director or Authorised Security Staff. Trigger: E39.\nThe Director or authorised security staff select halls and a day or period. The report shows occupancy over time, peak occupancy and when the warning and full-capacity thresholds were reached. Missing readings are marked unavailable."
						},
						{
							"_type": "UMLUseCase",
							"_id": "0ca20c790b7b4e5eb7ee9bb753cf76f6",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC40 View Average Hall Stay Report",
							"documentation": "Actors: Director or Authorised Reporting Staff. Trigger: E40.\nAverage hall-stay duration is calculated from valid completed anonymous visits for the selected period. The report includes the sample count. If there are no suitable records, the result is shown as unavailable."
						},
						{
							"_type": "UMLUseCase",
							"_id": "331d1b5de7ea4f42870a4ce53f95dfd3",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC41 View Artifact Scan and Guide Usage Report",
							"documentation": "Actors: Curatorial Staff or Director. Trigger: E41.\nCuratorial staff or the Director select a reporting period to review guide usage. The report also ranks artifacts by their recorded scan counts."
						},
						{
							"_type": "UMLUseCase",
							"_id": "7da0062a11f74db88a83b0cc34f845de",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC42 View Sales and Monthly Revenue Report",
							"documentation": "Actors: Authorised Ticketing Staff or Director. Trigger: E42.\nFor the selected Cairo calendar month, the report groups gross sales, refunds and net revenue by ticket type. It uses payment dates for sales and processing dates for refunds, including refunds against earlier purchases."
						},
						{
							"_type": "UMLUseCase",
							"_id": "5cba929d6d91485db14dfe06449e8faf",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC43 View Online Sales Target Report",
							"documentation": "Actors: Director or Ticketing Manager. Trigger: E43.\nThe Director or Ticketing Manager requests the online-sales assessment. The percentage uses online paid, non-refunded tickets divided by all paid, non-refunded tickets, excluding free school tickets. The simulated session's A-12 compares the preceding full month with the 80% target, 12 months after launch."
						},
						{
							"_type": "UMLUseCase",
							"_id": "908fe4ffad9f4440874cc7a45b1cbc18",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC44 Maintain Membership",
							"documentation": "Actors: Ticketing Manager; Members benefit from the result. Trigger: E44.\nThe Ticketing Manager records enrolments and membership validity changes. Active status determines queue priority and eligibility for invitations. Members still need valid bookings and must follow all capacity and closure rules."
						},
						{
							"_type": "UMLUseCase",
							"_id": "f08f54394fbb4ab68b0cee846af5a6f4",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC45 Issue Member Event Invitations",
							"documentation": "Actors: Ticketing Manager; Members receive invitations. Trigger: E45.\nThe Ticketing Manager requests invitations for an event. Eligible active members receive them according to the museum's configured terms."
						},
						{
							"_type": "UMLUseCase",
							"_id": "8b188a91ede94cd9af790a53d98e7c22",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC46 Record or Update Lost Child Case",
							"documentation": "Actors: Authorised Museum Staff. Trigger: E46.\nMuseum staff record or update a lost-child case on a tablet. The details remain available for private staff handling and security review."
						},
						{
							"_type": "UMLUseCase",
							"_id": "6898e5afaff34d58a5246d7689419e0b",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC47 Record or Update Lost Item Case",
							"documentation": "Actors: Authorised Museum Staff. Trigger: E47.\nStaff enter details of a lost or found item, then add updates and claim information as the case progresses."
						},
						{
							"_type": "UMLUseCase",
							"_id": "796846a5e60d48fd94596e9f989460a0",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC48 Publish Incident Alert",
							"documentation": "Actors: Authorised Security Staff; Visitors receive alerts. Trigger: E48.\nAuthorised security staff approve an incident alert for visitors. The published version contains the necessary description and a staff contact point; private contact details stay in the staff record."
						},
						{
							"_type": "UMLUseCase",
							"_id": "c97ad66de11e49259fdf9f7212c9eff0",
							"_parent": {
								"$ref": "d69eddcffbc14f4683970a0ea3f468ca"
							},
							"name": "UC49 Close Incident and Withdraw Alert",
							"documentation": "Actors: Authorised Security Staff. Trigger: E49.\nAfter staff verify that an incident has been resolved, security records the outcome. The case is closed and any active public alert linked to it is withdrawn."
						}
					]
				},
