								},
								{
									"_type": "UMLNoteView",
									"_id": "bee847ebcada4b109bfea05f26e5bd4b",
									"_parent": {
										"$ref": "04dcde3354d14780940f5fbf43a65ddf"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 40,
									"top": 410,
									"width": 180,
									"height": 145,
									"text": "Counts arrive every minute for 40 halls.\nNo facial recognition.\nHumidity data applies to sensitive halls."
								},
								{
									"_type": "UMLNoteView",
									"_id": "ebd42a2505374c7bb3967324c8ac06c9",
									"_parent": {
										"$ref": "04dcde3354d14780940f5fbf43a65ddf"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 920,
									"top": 420,
									"width": 220,
									"height": 270,
									"text": "Security Supervisor: close / reopen for maintenance or VIP.\n\nConservation: clear a humidity hold only after readings return to normal.\n\nOnly Chief Curator may change safe capacity."
								},
								{
									"_type": "UMLNoteView",
									"_id": "94e6f3c904bf41d29a89ce8325e4f23d",
									"_parent": {
										"$ref": "04dcde3354d14780940f5fbf43a65ddf"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 40,
									"top": 730,
									"width": 180,
									"height": 300,
									"text": "A-08 / A-09\nHigh humidity activates a hold. Keep it until readings are normal AND Conservation clears it.\n\n50% means half the normal admissions per minute, rounded down. Safe capacity stays unchanged."
								},
								{
									"_type": "UMLTextView",
									"_id": "2961d5e2e19048e7a657709d3de3f372",
									"_parent": {
										"$ref": "04dcde3354d14780940f5fbf43a65ddf"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 920,
									"top": 740,
									"width": 220,
									"height": 55,
									"text": "Full = count at or above safe capacity."
								},
								{
									"_type": "UMLNoteView",
									"_id": "15451dd029a64fa2b80ae54b4294ee5b",
									"_parent": {
										"$ref": "04dcde3354d14780940f5fbf43a65ddf"
									},
									"fillColor": "#FFFFFF",
									"font": "Arial;15;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 920,
									"top": 1545,
									"width": 220,
									"height": 90,
									"text": "Routes exclude closed / full halls.\nAt 85% or more, suggest quieter halls."
								},
